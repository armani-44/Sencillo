{%- comment -%}
  Site-wide age verification gate.
  Rendered from layout/theme.liquid so it appears on every page.
  Uses sessionStorage so it shows once per browser session.
{%- endcomment -%}

<div id="sencillo-age-gate" role="dialog" aria-modal="true" aria-labelledby="sencillo-age-title" style="position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:1.5rem;background:rgba(26,26,26,0.78);backdrop-filter:blur(14px) saturate(140%);-webkit-backdrop-filter:blur(14px) saturate(140%);font-family:'Jost',sans-serif;opacity:0;transition:opacity 0.45s cubic-bezier(0.16,1,0.3,1);">
  <div style="position:relative;width:100%;max-width:480px;background:linear-gradient(155deg,#FF7B29 0%,#FF5442 48%,#E10072 100%);border-radius:28px;padding:3rem 2.5rem 2.75rem;text-align:center;box-shadow:0 30px 80px -20px rgba(147,4,78,0.55),0 0 0 1px rgba(255,255,255,0.08),inset 0 1px 0 rgba(255,255,255,0.15);overflow:hidden;">
    <div style="position:absolute;inset:0;pointer-events:none;opacity:0.09;mix-blend-mode:overlay;background-image:url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;);background-size:180px 180px;border-radius:inherit;"></div>
    <div style="position:absolute;top:-90px;right:-90px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,#FFBC00 0%,#FF7B29 65%,transparent 75%);opacity:0.45;filter:blur(4px);pointer-events:none;"></div>
    <div style="position:absolute;bottom:-120px;left:-100px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,#93044E 0%,transparent 70%);opacity:0.4;pointer-events:none;"></div>

    <div id="sencillo-age-step1" style="position:relative;z-index:2;">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" style="width:120px;height:auto;margin:0 auto 1.5rem;display:block;filter:brightness(0) invert(1);" />
      {%- else -%}
        <p style="font-weight:900;font-size:1.6rem;letter-spacing:-0.03em;color:#fff;margin-bottom:1.5rem;">{{ shop.name }}</p>
      {%- endif -%}
      <p style="font-weight:700;font-size:0.68rem;letter-spacing:0.3em;color:rgba(255,255,255,0.85);text-transform:uppercase;margin-bottom:1rem;">Age Verification</p>
      <h2 id="sencillo-age-title" style="font-weight:900;letter-spacing:-0.03em;line-height:0.92;text-transform:uppercase;font-size:2.6rem;color:#fff;margin-bottom:1.25rem;">Are You<br>Over 18?</h2>
      <p style="font-size:0.95rem;line-height:1.65;color:rgba(255,255,255,0.92);max-width:340px;margin:0 auto 2rem;">You must be of legal drinking age in your country to enter this site.</p>
      <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
        <button id="sencillo-age-yes" type="button" style="flex:1;min-width:140px;padding:1rem 1.75rem;background:#fff;color:#E10072;font-weight:700;font-size:0.78rem;letter-spacing:0.18em;text-transform:uppercase;border:none;border-radius:999px;cursor:pointer;transition:transform 0.25s cubic-bezier(0.34,1.56,0.64,1),box-shadow 0.25s;box-shadow:0 8px 22px -8px rgba(0,0,0,0.35);font-family:'Jost',sans-serif;">Yes, I Am</button>
        <button id="sencillo-age-no" type="button" style="flex:1;min-width:140px;padding:1rem 1.75rem;background:transparent;color:#fff;font-weight:700;font-size:0.78rem;letter-spacing:0.18em;text-transform:uppercase;border:1.5px solid rgba(255,255,255,0.55);border-radius:999px;cursor:pointer;transition:background 0.25s,border-color 0.25s;font-family:'Jost',sans-serif;">No, I'm Not</button>
      </div>
      <p style="margin-top:1.75rem;font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.7);">Please drink responsibly</p>
    </div>

    <div id="sencillo-age-step2" style="position:relative;z-index:2;display:none;">
      <p style="font-weight:700;font-size:0.68rem;letter-spacing:0.3em;color:rgba(255,255,255,0.85);text-transform:uppercase;margin-bottom:1rem;">Sorry</p>
      <h2 style="font-weight:900;letter-spacing:-0.03em;line-height:0.92;text-transform:uppercase;font-size:2.4rem;color:#fff;margin-bottom:1.25rem;">Come Back<br>When You're 18</h2>
      <p style="font-size:0.95rem;line-height:1.65;color:rgba(255,255,255,0.92);max-width:340px;margin:0 auto 1.5rem;">You must be of legal drinking age to access {{ shop.name }}.</p>
    </div>
  </div>
</div>

<script>
(function(){
  var gate = document.getElementById('sencillo-age-gate');
  if (!gate) return;
  var step1 = document.getElementById('sencillo-age-step1');
  var step2 = document.getElementById('sencillo-age-step2');
  var yesBtn = document.getElementById('sencillo-age-yes');
  var noBtn = document.getElementById('sencillo-age-no');
  if (sessionStorage.getItem('sencilloAgeVerified') !== 'true') {
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
    gate.style.display = 'flex';
    requestAnimationFrame(function(){ gate.style.opacity = '1'; });
  }
  yesBtn.addEventListener('click', function(){
    sessionStorage.setItem('sencilloAgeVerified', 'true');
    gate.style.opacity = '0';
    setTimeout(function(){
      gate.style.display = 'none';
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    }, 450);
  });
  noBtn.addEventListener('click', function(){
    step1.style.display = 'none';
    step2.style.display = 'block';
  });
})();
</script>

            <td>Session – 1 year</td>
          </tr>
          <tr>
            <td><code>_gcl_au</code>, <code>_gcl_aw</code></td>
            <td>Google Ads — attributes conversions and measures ad performance.</td>
            <td>Marketing</td>
            <td>3 months</td>
          </tr>
          <tr>
            <td><code>_fbp</code>, <code>_fbc</code></td>
            <td>Meta (Facebook/Instagram) Pixel — measures ad performance and supports retargeting.</td>
            <td>Marketing</td>
            <td>3 months</td>
          </tr>
          <tr>
            <td><code>_ttp</code></td>
            <td>TikTok Pixel — measures ad performance on TikTok.</td>
            <td>Marketing</td>
            <td>13 months</td>
          </tr>
          <tr>
            <td><code>_pin_unauth</code>, <code>_pinterest_ct_ua</code></td>
            <td>Pinterest Tag — measures ad performance on Pinterest.</td>

            <td>14 days</td>
          </tr>
          <tr>
            <td><code>_shopify_*</code></td>
            <td>Set by Shopify to operate the checkout, fraud-prevention and load-balancing.</td>
            <td>Strictly necessary</td>
            <td>Session – 2 years</td>
          </tr>
          <tr>
            <td><code>_ga</code>, <code>_ga_*</code></td>
            <td>Google Analytics 4 — distinguishes unique visitors and measures site usage.</td>
